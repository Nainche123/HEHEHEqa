# ============================================================
# NEXIVO HUB Shared Discord Bot Worker
# 이 파일에는 '공용 봇 1개'의 토큰만 넣습니다.
# 고객별 토큰을 넣지 않습니다.
# ============================================================

# Discord Developer Portal에서 발급한 단 하나의 공용 봇 토큰
DISCORD_TOKEN=
# 비워두면 NEXIVO HUB 설정에 저장된 공용 Bot Token을 Worker Secret 인증으로 안전하게 가져옵니다. 웹에서 Token 저장 후 Worker가 자동으로 시작합니다.

# NEXIVO HUB 웹 서비스의 공개 주소
WEBSITE_URL=https://YOUR-NEXIVO HUB.onrender.com

# 웹과 봇 워커만 공유하는 긴 랜덤 시크릿
NEXIVO_BOT_WORKER_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

# 선택 사항: 기본 길드/오너/티켓 채널 설정
# 실제 고객 서버 연결은 웹 패널에서 라이선스별 Guild ID를 저장합니다.
GUILD_ID=0
OWNER_ID=0
ORDER_CATEGORY_ID=0
REVIEW_CHANNEL_ID=0
PURCHASE_LOG_CHANNEL_ID=0
VERIFICATION_CHANNEL_ID=0
VERIFIED_ROLE_ID=0
BUYER_ROLE_ID=0
BANK_INFO=입금 계좌는 관리자에게 안내받아 주세요.
ADMIN_NAME=NEXIVO HUB 운영팀

NEXIVO_BOT_CLIENT_ID=YOUR_DISCORD_APPLICATION_CLIENT_ID
NEXIVO_BOT_INVITE_URL=https://discord.com/oauth2/authorize?client_id=YOUR_CLIENT_ID&scope=bot%20applications.commands
NEXIVO_BOT_DISPLAY_NAME=NEXIVO HUB Bot
